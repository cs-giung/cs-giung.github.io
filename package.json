{
  "name": "cs-giung",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-export.mjs",
    "preview": "node scripts/serve-export.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "test:blog": "node --test tests/unit/blog-data.test.mjs tests/unit/reading-layout.test.mjs tests/unit/math-layout.test.mjs tests/unit/content-data.test.mjs",
    "test:cv": "node --test tests/unit/cv-data.test.mjs",
    "test:email": "node --test tests/unit/email-obfuscation.test.mjs",
    "test:export": "node --test tests/export/*.test.mjs && npm run check:email-export",
    "test:browser": "playwright test",
    "check:blog-export": "node --test tests/export/blog-export.test.mjs",
    "check:email-export": "node scripts/check-email-export.mjs",
    "check:public": "node scripts/check-public-release.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm run build && npm run test:export",
    "new-post": "node scripts/new-post.js",
    "fonts:blog-cjk": "node scripts/update-blog-cjk-font.mjs",
    "fonts:interface": "node scripts/update-interface-fonts.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
